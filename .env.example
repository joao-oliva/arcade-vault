# Resend API key (https://resend.com/api-keys). Server-only: never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Team inbox that receives the contact form messages.
# While using onboarding@resend.dev as sender, Resend only delivers to the email
# that owns the Resend account, so this must be that email until a domain is verified.
CONTACT_TO_EMAIL=

# Sender. Defaults to "Arcade Vault <onboarding@resend.dev>" when empty.
CONTACT_FROM_EMAIL=
